# ============================================================
#  COET Akola Chatbot — Environment Config Template
#  INSTRUCTIONS: Copy this file to .env and fill in your actual values
# ============================================================

# Database Configuration
DB_HOST=localhost
DB_USER=root
DB_PASS=
DB_NAME=college_chatbot

# Gemini AI API Key (Get from: https://aistudio.google.com/)
GEMINI_API_KEY=your_gemini_api_key_here

# Your website URL (change this after hosting)
# Example: https://chatbot.coetakola.ac.in
SITE_URL=http://localhost/coet_production

# Allowed origin for CORS (e.g. https://yourdomain.com or * for local testing)
ALLOWED_ORIGIN=*
